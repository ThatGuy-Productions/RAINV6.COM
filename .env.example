# RAIN V6 — environment template (copy to .env.local / host secrets)
# Never commit real merchant keys.

# Canonical PostgreSQL (required for deployed runtime)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/rainv6?schema=public

# Public site origin (required before live payments)
NEXT_PUBLIC_APP_URL=https://your-production-domain.example

# PayFast (server only)
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
# Keep false until public URL is confirmed with PayFast dashboard
PAYFAST_LIVE_ENABLED=false
# true = sandbox.payfast.co.za host
PAYFAST_TEST_MODE=true

# Extra kill switch: non-false keeps payment path in non-live mode
RAIN_BETA_MODE=true

# Optional signing secret for internal payment receipts
PAYMENT_SIGNING_SECRET=

# Feature flags (default off)
RAIN_FEATURE_NEURAL_STEMS=false
RAIN_FEATURE_NEURAL_INFERENCE_LABEL=false
RAIN_FEATURE_LIVE_DISTRIBUTION=false
