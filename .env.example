# Copy to .env.local for local development. Never commit real credentials.
# Production rate limiting requires a shared Upstash Redis REST endpoint.
# Set both values in the deployment environment; production requests to
# rate-limited routes fail closed with HTTP 503 if the shared store is absent
# or unavailable. Local development may use an in-memory fallback.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Existing application configuration belongs here as required by the
# deployment. Do not put real secrets in this example file.
